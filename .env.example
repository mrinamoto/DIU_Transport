NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5000
WEB_DATABASE_PATH=backend/data/diu_transport_web.db
AUTH_SECRET=replace-with-at-least-32-random-characters
AUTH_EXPIRES_IN=1h
PUBLIC_REGISTRATION_ROLES=STUDENT,TEACHER
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=300
TRUST_PROXY=false
AUDIT_PAGE_SIZE_MAX=100
BACKUP_DIRECTORY=backend/backups
EXPORT_DIRECTORY=backend/exports
FEEDBACK_RATE_LIMIT_WINDOW_MS=600000
FEEDBACK_RATE_LIMIT_MAX=10
NOTIFICATION_PAGE_SIZE_MAX=100
FEEDBACK_PAGE_SIZE_MAX=100
SPECIAL_TRIP_PAGE_SIZE_MAX=100
